# MCP Bridge example configuration.
#
# Copy only the settings you need into your local MCP Bridge environment file.
# Never commit a real token, OAuth password, cookie, tunnel credential, or API key.
#
# Native helper defaults:
#   Linux/macOS: ~/.config/mcp-bridge/env (or the helper-specific XDG/macOS path)
#   Windows:      current user's LocalApplicationData\mcp-bridge\env
# Override the helper target explicitly with MCP_BRIDGE_ENV_FILE when needed.

MCP_PROFILE=personal-desktop
MCP_HOST=127.0.0.1
MCP_PORT=3000

# Use a directory that exists on the machine running the bridge. A relative
# path is resolved from the bridge working directory and canonicalized at
# startup; an absolute path is also supported. Do not copy another user's
# drive letter, home directory, or username.
BRIDGE_WORKDIR=.
BRIDGE_BACKEND_URL=http://127.0.0.1:4097

# Host automation is opt-in.
MCP_ENABLE_SHELL=true
MCP_ENABLE_BROWSER=true

# For local/static bearer authentication, generate a unique secret locally.
# Examples:
#   Linux/macOS: MCP_TOKEN="$(openssl rand -hex 32)"
#   PowerShell:  use a locally generated high-entropy token and set MCP_TOKEN
#                in the process/service environment.

# For ChatGPT/OAuth, use the native bootstrap helper:
#   Linux/macOS: bash scripts/bootstrap-oauth.sh https://your-domain.example.com
#   Windows:     .\scripts\bootstrap-oauth.ps1 https://your-domain.example.com
#
# It generates a unique password locally and writes OAuth values to the
# current user's MCP Bridge environment file. You can override that location
# with MCP_BRIDGE_ENV_FILE.
#
# Manual OAuth configuration remains supported:
# MCP_PUBLIC_URL=https://your-domain.example.com
# MCP_OAUTH_USERNAME=admin
# MCP_OAUTH_PASSWORD=YOUR_PASSWORD_HERE

# Trust forwarded client IPs only when a trusted loopback Cloudflare process
# is actually in front of the bridge.
MCP_TRUST_PROXY=none
