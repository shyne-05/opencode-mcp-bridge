# MCP Bridge example configuration.
# Copy only the settings you need into ~/.config/mcp-bridge/env.
# Never commit a real token, OAuth password, cookie, tunnel credential, or API key.

MCP_PROFILE=personal-desktop
MCP_HOST=127.0.0.1
MCP_PORT=3000
BRIDGE_WORKDIR=/home/your-user/opencode-mcp-bridge-rust
BRIDGE_BACKEND_URL=http://127.0.0.1:4097

# Host automation is opt-in.
MCP_ENABLE_SHELL=true
MCP_ENABLE_BROWSER=true

# For local/static bearer authentication, generate a unique secret locally:
# MCP_TOKEN=<run: openssl rand -hex 32>

# For ChatGPT/OAuth, the recommended setup is the bootstrap helper:
#   bash scripts/bootstrap-oauth.sh https://your-domain.example.com
#
# It generates a unique password locally and writes the OAuth values to
# ~/.config/mcp-bridge/env with mode 600.
#
# If you prefer to choose the OAuth password yourself, copy these lines into
# ~/.config/mcp-bridge/env and REPLACE YOUR_PASSWORD_HERE before starting:
# MCP_PUBLIC_URL=https://your-domain.example.com
# MCP_OAUTH_USERNAME=admin
# MCP_OAUTH_PASSWORD=YOUR_PASSWORD_HERE

# Trust forwarded client IPs only when a trusted loopback Cloudflare process
# is actually in front of the bridge.
MCP_TRUST_PROXY=none
